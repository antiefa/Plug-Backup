#: plugbackup/appcore/presentation.py:12
msgid "This drive is not bound to the profile."
msgstr "Этот носитель не привязан к профилю."

#: plugbackup/appcore/presentation.py:13 plugbackup/ui/profile_view.py:495
msgid "The drive is encrypted and locked."
msgstr "Носитель зашифрован и заблокирован."

#: plugbackup/appcore/presentation.py:14
msgid "The drive is not mounted."
msgstr "Носитель не подключён."

#: plugbackup/appcore/presentation.py:15 plugbackup/appcore/presentation.py:16
msgid "The mounted file system does not match the profile’s drive."
msgstr "Подключённая файловая система не совпадает с носителем профиля."

#: plugbackup/appcore/presentation.py:17
msgid "Only a subfolder of the drive is mounted."
msgstr "Подключена только папка носителя, а не весь носитель."

#: plugbackup/appcore/presentation.py:18
msgid "The drive is mounted read-only."
msgstr "Носитель подключён только для чтения."

#: plugbackup/appcore/presentation.py:19
msgid "You do not have permission to write to the drive."
msgstr "Нет прав на запись на носитель."

#: plugbackup/appcore/presentation.py:20
msgid "The backup folder name is invalid."
msgstr "Недопустимое имя папки копии."

#: plugbackup/appcore/presentation.py:21
msgid ""
"The backup folder on the drive is a link to somewhere else; it will not be "
"used."
msgstr ""
"Папка копии на носителе — ссылка в другое место; она использоваться не "
"будет."

#: plugbackup/appcore/presentation.py:22
msgid ""
"Something that is not a folder has the backup folder’s name on the drive."
msgstr "На носителе с именем папки копии лежит не папка."

#: plugbackup/appcore/presentation.py:23
#: plugbackup/appcore/presentation.py:109
msgid "The profile’s encrypted folder has not been created on this drive yet."
msgstr "Зашифрованная папка профиля на этом носителе ещё не создана."

#: plugbackup/appcore/presentation.py:24
msgid "The profile’s encrypted folder is closed."
msgstr "Зашифрованная папка профиля закрыта."

#: plugbackup/appcore/presentation.py:25
msgid "The backup folder on the drive belongs to another profile."
msgstr "Папка копии на носителе принадлежит другому профилю."

#: plugbackup/appcore/presentation.py:26
msgid "The profile marker on the drive is damaged."
msgstr "Метка профиля на носителе повреждена."

#: plugbackup/appcore/presentation.py:27
msgid ""
"The backup folder on the drive already contains data without a profile "
"marker."
msgstr "В папке копии на носителе уже есть данные без метки профиля."

#: plugbackup/appcore/presentation.py:29
#, python-format
msgid "The drive cannot be used right now (%s)."
msgstr "Носитель сейчас нельзя использовать (%s)."

#: plugbackup/appcore/presentation.py:41 plugbackup/ui/volumes_view.py:46
#, python-format
msgid "%s inside LUKS"
msgstr "%s внутри LUKS"

#: plugbackup/appcore/presentation.py:50 plugbackup/qt/main_window.py:670
#: plugbackup/qt/main_window.py:750
msgid "completed"
msgstr "выполнено"

#: plugbackup/appcore/presentation.py:51
msgid "completed with notes"
msgstr "выполнено с замечаниями"

#: plugbackup/appcore/presentation.py:52
msgid "error"
msgstr "ошибка"

#: plugbackup/appcore/presentation.py:53
msgid "stopped"
msgstr "остановлено"

#: plugbackup/appcore/presentation.py:54
msgid "skipped"
msgstr "пропущено"

#: plugbackup/appcore/presentation.py:69
msgid "no changes"
msgstr "изменений нет"

#: plugbackup/appcore/presentation.py:74
msgid "manual"
msgstr "вручную"

#: plugbackup/appcore/presentation.py:74
msgid "command line"
msgstr "командная строка"

#: plugbackup/appcore/presentation.py:74
msgid "automatic"
msgstr "автоматически"

#: plugbackup/appcore/presentation.py:75
msgid "restore"
msgstr "восстановление"

#: plugbackup/appcore/presentation.py:82
msgid "This profile is already being backed up."
msgstr "Этот профиль уже резервируется."

#: plugbackup/appcore/presentation.py:83
msgid "There is no copy of this job on the drive."
msgstr "Копии этого задания на носителе нет."

#: plugbackup/appcore/presentation.py:84
msgid ""
"No changes — the copy is up to date (checked automatically, nothing was "
"written)."
msgstr ""
"Изменений нет — копия актуальна (проверено автоматически, ничего не "
"записывалось)."

#: plugbackup/appcore/presentation.py:85
msgid ""
"The backup folder contains data without a profile marker, and it was not "
"accepted."
msgstr "В папке копии есть данные без метки профиля, и они не были приняты."

#: plugbackup/appcore/presentation.py:86
msgid "Could not write the profile marker to the drive."
msgstr "Не удалось записать метку профиля на носитель."

#: plugbackup/appcore/presentation.py:87
msgid ""
"The source folder is empty while the copy has files — the copy was left "
"untouched. If the folder is empty on purpose, clear the job’s copy manually."
msgstr ""
"Папка-источник пуста, а в копии есть файлы — копия не тронута. Если папка "
"пуста намеренно, очистите копию задания вручную."

#: plugbackup/appcore/presentation.py:89
msgid ""
"Some file names differ only in letter case; on this drive they would "
"overwrite each other. Rename or exclude them."
msgstr ""
"Имена некоторых файлов различаются только регистром букв — на этом носителе "
"они затёрли бы друг друга. Переименуйте или исключите их."

#: plugbackup/appcore/presentation.py:91
msgid ""
"The job folder on the drive already has data that is not marked as this "
"job’s copy, and it was not accepted."
msgstr ""
"В папке задания на носителе уже есть данные, не отмеченные как копия этого "
"задания, и они не были приняты."

#: plugbackup/appcore/presentation.py:93
msgid "Too many files would be deleted from the copy; the job was skipped."
msgstr "Из копии удалилось бы слишком много файлов — задание пропущено."

#: plugbackup/appcore/presentation.py:94
msgid "Not enough free space on the drive."
msgstr "Недостаточно места на носителе."

#: plugbackup/appcore/presentation.py:95
msgid ""
"The file times on the drive look shifted by whole hours (usually after "
"changing the operating system or time zone); the job was skipped so that "
"unchanged files are not copied again. Run the backup manually to fix the "
"times."
msgstr ""
"Время файлов на носителе сдвинуто на целое число часов (обычно после смены "
"операционной системы или часового пояса); задание пропущено, чтобы не "
"копировать заново неизменённые файлы. Запустите резервирование вручную, "
"чтобы исправить время."

#: plugbackup/appcore/presentation.py:98
msgid "Could not read the source folder."
msgstr "Не удалось прочитать папку-источник."

#: plugbackup/appcore/presentation.py:99
msgid "Could not prepare the copy plan."
msgstr "Не удалось составить план копирования."

#: plugbackup/appcore/presentation.py:100
msgid "The hard limit on deletions per run was reached; deletions stopped."
msgstr "Достигнут жёсткий предел удалений за запуск — удаление остановлено."

#: plugbackup/appcore/presentation.py:101
msgid "Some files could not be copied (see the log)."
msgstr "Часть файлов скопировать не удалось (см. журнал)."

#: plugbackup/appcore/presentation.py:102
msgid "Some files disappeared while copying."
msgstr "Часть файлов исчезла во время копирования."

#: plugbackup/appcore/presentation.py:103
msgid "The drive was disconnected or changed during the backup."
msgstr "Во время резервирования носитель был отключён или подменён."

#: plugbackup/appcore/presentation.py:104
msgid "Stopped by the user."
msgstr "Остановлено пользователем."

#: plugbackup/appcore/presentation.py:105
msgid "The copy process was interrupted."
msgstr "Процесс копирования был прерван."

#: plugbackup/appcore/presentation.py:106
#, python-format
msgid "System error: %s"
msgstr "Системная ошибка: %s"

#: plugbackup/appcore/presentation.py:107
msgid ""
"A folder on the drive is a link to somewhere else; it will not be written "
"to."
msgstr ""
"Папка на носителе — ссылка в другое место; запись туда не выполняется."

#: plugbackup/appcore/presentation.py:108
msgid "Something that is not a folder blocks the job’s path on the drive."
msgstr "Путь задания на носителе занят не папкой."

#: plugbackup/appcore/presentation.py:110
msgid "The encrypted folder is closed (no password)."
msgstr "Зашифрованная папка закрыта (нет пароля)."

#: plugbackup/appcore/presentation.py:115
#, python-format
msgid "rsync finished with error code %s."
msgstr "rsync завершился с кодом ошибки %s."

#: plugbackup/app.py:58
msgid "Show the version and exit"
msgstr "Показать версию и выйти"

#: plugbackup/app.py:60
msgid "Check system components and exit"
msgstr "Проверить компоненты системы и выйти"

#: plugbackup/app.py:62
msgid "List profiles and their drives, then exit"
msgstr "Показать профили и их носители и выйти"

#: plugbackup/app.py:64
msgid "Back up the profile with this name or ID without a window"
msgstr "Зарезервировать профиль с этим именем или ID без окна"

#: plugbackup/app.py:64
msgid "PROFILE"
msgstr "ПРОФИЛЬ"

#: plugbackup/app.py:66
msgid "Start minimized to the tray"
msgstr "Запустить свёрнутым в трей"

#: plugbackup/app.py:235
msgid "backing up"
msgstr "идёт резервирование"

#: plugbackup/app.py:237
msgid "starting soon"
msgstr "скоро начнётся"

#: plugbackup/app.py:239 plugbackup/qt/main_window.py:711
#: plugbackup/ui/sidebar.py:26
msgid "drive not connected"
msgstr "носитель не подключён"

#: plugbackup/app.py:241 plugbackup/qt/main_window.py:712
#: plugbackup/qt/main_window.py:719
msgid "drive connected, locked"
msgstr "носитель подключён, заблокирован"

#: plugbackup/app.py:244 plugbackup/qt/main_window.py:279
#: plugbackup/qt/main_window.py:711 plugbackup/qt/main_window.py:714
#: plugbackup/ui/sidebar.py:28
msgid "drive connected"
msgstr "носитель подключён"

#: plugbackup/app.py:248
#, python-format
msgid "copy is up to date (checked at %s)"
msgstr "копия актуальна (проверено в %s)"

#: plugbackup/app.py:250
#, python-format
msgid "last run at %s: %s"
msgstr "последний запуск в %s: %s"

#: plugbackup/app.py:271
msgid "Automatic backup is paused"
msgstr "Автоматическое резервирование приостановлено"

#: plugbackup/app.py:272
msgid "No connected drives"
msgstr "Носители не подключены"

#: plugbackup/app.py:290
#, python-format
msgid "Could not change the “Start at login” setting: %s"
msgstr "Не удалось изменить автозагрузку: %s"

#: plugbackup/app.py:347
#, python-format
msgid "Could not restore settings: %s"
msgstr "Не удалось восстановить настройки: %s"

#: plugbackup/app.py:362
#, python-format
msgid "Could not restore profiles: %s"
msgstr "Не удалось восстановить профили: %s"

#: plugbackup/app.py:383
msgid ""
"Back up selected folders to removable drives with one click or automatically"
" when the drive is inserted."
msgstr ""
"Резервное копирование выбранных папок на сменные носители одной кнопкой или "
"автоматически при вставке носителя."

#: plugbackup/core/fsinfo.py:40
msgid "Files of 4 GiB (4,294,967,296 bytes) and larger do not fit."
msgstr "Файлы размером 4 ГиБ (4 294 967 296 байт) и больше не поместятся."

#: plugbackup/core/fsinfo.py:41 plugbackup/core/fsinfo.py:44
msgid "Linux permissions and symbolic links are not preserved."
msgstr "Права доступа Linux и символьные ссылки не сохраняются."

#: plugbackup/core/fsinfo.py:46
msgid "Linux permissions are not preserved."
msgstr "Права доступа Linux не сохраняются."

#: plugbackup/core/fsinfo.py:50 plugbackup/ui/volumes_view.py:191
msgid "This file system has not been tested with Plug & Backup."
msgstr "Эта файловая система не проверялась с Plug & Backup."

#: plugbackup/core/profiles.py:342
msgid "The backup folder name on the drive is empty."
msgstr "Не указано имя папки копии на носителе."

#: plugbackup/core/profiles.py:344
msgid "The backup folder on the drive must be a single folder name."
msgstr "Папка копии на носителе должна быть одним именем папки."

#: plugbackup/core/profiles.py:346 plugbackup/core/profiles.py:361
#, python-format
msgid "“%s” is a reserved service name."
msgstr "«%s» — зарезервированное служебное имя."

#: plugbackup/core/profiles.py:353
msgid "The destination folder on the drive is empty."
msgstr "Не указана папка на носителе."

#: plugbackup/core/profiles.py:355
msgid ""
"The destination must be a folder inside the backup folder, not an absolute "
"path."
msgstr ""
"Папка на носителе должна быть внутри папки копии, а не абсолютным путём."

#: plugbackup/core/profiles.py:358
msgid "The destination must not contain “..”."
msgstr "Путь на носителе не должен содержать «..»."

#: plugbackup/core/profiles.py:370
msgid "Choose a folder on this computer to back up."
msgstr "Выберите папку на этом компьютере."

#: plugbackup/core/profiles.py:372
msgid "The source folder must be an absolute path."
msgstr "Папка-источник должна быть абсолютным путём."

#: plugbackup/core/profiles.py:376
msgid "A system folder cannot be backed up as a whole."
msgstr "Системную папку целиком резервировать нельзя."

#: plugbackup/core/profiles.py:378
msgid "The source folder does not exist."
msgstr "Папки-источника не существует."

#: plugbackup/core/profiles.py:380
msgid "The source is not a folder."
msgstr "Источник — не папка."

#: plugbackup/core/profiles.py:382
msgid "The source folder cannot be read."
msgstr "Папку-источник нельзя прочитать."

#: plugbackup/core/profiles.py:385
msgid "The source folder is on the backup drive itself."
msgstr "Папка-источник находится на самом носителе копии."

#: plugbackup/core/profiles.py:388
msgid ""
"The source folder contains the backup drive; the copy would include itself."
msgstr ""
"Внутри папки-источника находится носитель копии — копия включала бы саму "
"себя."

#: plugbackup/core/profiles.py:397
#, python-format
msgid "The destination overlaps with another job (“%s”)."
msgstr "Папка на носителе пересекается с другим заданием («%s»)."

#: plugbackup/core/profiles.py:401
msgid "The source overlaps with another job; some files will be copied twice."
msgstr ""
"Источник пересекается с другим заданием — часть файлов скопируется дважды."

#: plugbackup/core/profiles.py:405
msgid ""
"Mirror mode: files deleted on this computer are deleted from the copy too, "
"and changed files replace their previous versions — they cannot be got back."
msgstr ""
"Режим «Зеркало»: файлы, удалённые на этом компьютере, удаляются и из копии, "
"а изменённые заменяют прежние версии — вернуть их будет нельзя."

#: plugbackup/core/profiles.py:408
msgid "The file size limit must be a positive number."
msgstr "Предел размера файла должен быть положительным числом."

#: plugbackup/core/profiles.py:411
msgid "An exclusion pattern must be a single line."
msgstr "Шаблон исключения должен быть одной строкой."

#: plugbackup/core/profiles.py:419
msgid "Enter a profile name."
msgstr "Введите имя профиля."

#: plugbackup/core/profiles.py:422
msgid "The countdown must be between 0 and 600 seconds."
msgstr "Отсчёт — от 0 до 600 секунд."

#: plugbackup/core/profiles.py:424
msgid "Versions must be kept for at least one day."
msgstr "Версии нужно хранить хотя бы один день."

#. TRANSLATORS: folder name in the home folder for files restored into another
#. place
#: plugbackup/core/restore.py:35
msgid "Restored"
msgstr "Восстановлено"

#: plugbackup/core/restore.py:94
msgid "Plug & Backup — files set aside during a restore"
msgstr "Plug & Backup — файлы, отложенные при восстановлении"

#: plugbackup/core/restore.py:97
#, python-format
msgid "Restored at: %s"
msgstr "Восстановление: %s"

#: plugbackup/core/restore.py:98
#, python-format
msgid "From the copy: %s"
msgstr "Из копии: %s"

#: plugbackup/core/restore.py:99
#, python-format
msgid "Into the folder: %s"
msgstr "В папку: %s"

#: plugbackup/core/restore.py:100
msgid ""
"These are the versions of files that were in the folder on this computer "
"BEFORE the restore and that the restore overwrote. Paths inside this folder "
"are the same as in the target folder. To get a file back, copy it from here "
"to the target folder."
msgstr ""
"Здесь лежат версии файлов, которые были в папке на компьютере ДО "
"восстановления и которые восстановление перезаписало. Пути внутри этой папки"
" — те же, что в папке назначения. Чтобы вернуть файл, скопируйте его отсюда "
"обратно в папку назначения."

#: plugbackup/core/runner.py:301
msgid "FAT32 time shift detected"
msgstr "Сдвиг времени на FAT32"

#: plugbackup/core/runner.py:302
#, python-format
msgid ""
"The file times on the drive appear to be shifted by %d hours (usually after "
"changing the operating system or time zone). Update only the file times on "
"the drive without copying them?"
msgstr ""
"Время файлов на носителе, похоже, сдвинуто на %d ч (обычно после смены "
"операционной системы или часового пояса). Обновить только время файлов на "
"носителе, не копируя их заново?"

#: plugbackup/core/runner.py:308
#, python-format
msgid "Updated the times of %d files on the drive."
msgstr "Обновлено время файлов на носителе: %d."

#: plugbackup/plat/linux/deps.py:85 plugbackup/plat/windows/deps.py:28
msgid "Interface"
msgstr "Интерфейс"

#: plugbackup/plat/linux/deps.py:88 plugbackup/plat/linux/deps.py:91
msgid "Drive detection"
msgstr "Обнаружение носителей"

#: plugbackup/plat/linux/deps.py:91
