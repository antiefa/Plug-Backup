msgstr "Служба org.freedesktop.UDisks2 недоступна на системной шине"

#: plugbackup/plat/linux/deps.py:97
msgid "Copying"
msgstr "Копирование"

#: plugbackup/plat/linux/deps.py:100
msgid "Notifications"
msgstr "Уведомления"

#: plugbackup/plat/linux/deps.py:109
msgid "Neither XApp nor AyatanaAppIndicator3 is installed"
msgstr "Не установлен ни XApp, ни AyatanaAppIndicator3"

#: plugbackup/plat/linux/deps.py:111
msgid "Tray icon"
msgstr "Значок в трее"

#: plugbackup/plat/linux/deps.py:116 plugbackup/plat/linux/deps.py:119
msgid "Password storage"
msgstr "Хранение паролей"

#: plugbackup/plat/linux/deps.py:119
msgid "Keyring service (Secret Service)"
msgstr "Служба связки ключей (Secret Service)"

#: plugbackup/plat/linux/deps.py:120
msgid "No Secret Service on the session bus (for example, gnome-keyring)"
msgstr "Нет службы Secret Service на сеансовой шине (например, gnome-keyring)"

#: plugbackup/plat/linux/deps.py:125
msgid "Encrypted drives (LUKS)"
msgstr "Зашифрованные носители (LUKS)"

#: plugbackup/plat/linux/deps.py:129 plugbackup/plat/linux/deps.py:132
msgid "Encrypted folder (gocryptfs)"
msgstr "Зашифрованная папка (gocryptfs)"

#: plugbackup/plat/windows/deps.py:23
msgid "Operating system"
msgstr "Операционная система"

#: plugbackup/plat/windows/deps.py:23
msgid "Windows 7 SP1 / 10 / 11"
msgstr "Windows 7 SP1 / 10 / 11"

#: plugbackup/plat/windows/deps.py:24
msgid "Windows 7 SP1 or later is required"
msgstr "Нужна Windows 7 SP1 или новее"

#: plugbackup/plat/windows/deps.py:26
msgid "Python"
msgstr "Python"

#: plugbackup/plat/windows/deps.py:26
msgid "Python 3.8+"
msgstr "Python 3.8+"

#: plugbackup/plat/windows/deps.py:29
msgid "PyQt5 is unavailable; the command line remains available"
msgstr "PyQt5 недоступен; командная строка работает"

#: plugbackup/plat/windows/deps.py:36
msgid "Windows services"
msgstr "Службы Windows"

#: plugbackup/plat/windows/devices.py:186
msgid "Physical disk number is unknown"
msgstr "Номер физического диска неизвестен"

#: plugbackup/plat/windows/devices.py:196
msgid "Ejection was blocked"
msgstr "Извлечение запрещено"

#: plugbackup/plat/windows/devices.py:198
msgid "Could not eject the device"
msgstr "Не удалось извлечь устройство"

#: plugbackup/qt/job_dialog.py:46 plugbackup/ui/job_dialog.py:17
#: plugbackup/ui/profile_view.py:125
msgid "Edit job"
msgstr "Изменить задание"

#: plugbackup/qt/job_dialog.py:46 plugbackup/ui/job_dialog.py:17
msgid "New job"
msgstr "Новое задание"

#: plugbackup/qt/job_dialog.py:66 plugbackup/qt/job_dialog.py:185
#: plugbackup/ui/job_dialog.py:38
msgid "Folder to back up"
msgstr "Папка для резервирования"

#: plugbackup/qt/job_dialog.py:72 plugbackup/ui/job_dialog.py:43
msgid "Folder on this computer"
msgstr "Папка на компьютере"

#: plugbackup/qt/job_dialog.py:74 plugbackup/ui/job_dialog.py:46
msgid "Folder name inside the backup folder"
msgstr "Имя папки внутри папки копии"

#: plugbackup/qt/job_dialog.py:75 plugbackup/ui/job_dialog.py:48
