#: plugbackup/app.py:58
msgid "Show the version and exit"
msgstr "Показать версию и выйти"

#: plugbackup/app.py:60
msgid "Check system components and exit"
msgstr "Проверить компоненты системы и выйти"

#: plugbackup/app.py:62
msgid "List profiles and their drives, then exit"
msgstr "Показать профили и их носители и выйти"

#: plugbackup/app.py:64
msgid "Back up the profile with this name or ID without a window"
msgstr "Зарезервировать профиль с этим именем или ID без окна"

#: plugbackup/app.py:64
msgid "PROFILE"
msgstr "ПРОФИЛЬ"

#: plugbackup/app.py:66
msgid "Start minimized to the tray"
msgstr "Запустить свёрнутым в трей"

#: plugbackup/app.py:233
msgid "backing up"
msgstr "идёт резервирование"

#: plugbackup/app.py:235
msgid "starting soon"
msgstr "скоро начнётся"

#: plugbackup/app.py:237 plugbackup/ui/sidebar.py:26
msgid "drive not connected"
msgstr "носитель не подключён"

#: plugbackup/app.py:239
msgid "drive connected, locked"
msgstr "носитель подключён, заблокирован"

#: plugbackup/app.py:242 plugbackup/ui/sidebar.py:28
msgid "drive connected"
msgstr "носитель подключён"

#: plugbackup/app.py:246
#, python-format
msgid "copy is up to date (checked at %s)"
msgstr "копия актуальна (проверено в %s)"

#: plugbackup/app.py:248
#, python-format
msgid "last run at %s: %s"
msgstr "последний запуск в %s: %s"

#: plugbackup/app.py:269
msgid "Automatic backup is paused"
msgstr "Автоматическое резервирование приостановлено"

#: plugbackup/app.py:270
msgid "No connected drives"
msgstr "Носители не подключены"

#: plugbackup/app.py:287
#, python-format
msgid "Could not change the “Start at login” setting: %s"
msgstr "Не удалось изменить автозагрузку: %s"

#: plugbackup/app.py:344
#, python-format
msgid "Could not restore settings: %s"
msgstr "Не удалось восстановить настройки: %s"

#: plugbackup/app.py:359
#, python-format
msgid "Could not restore profiles: %s"
msgstr "Не удалось восстановить профили: %s"

#: plugbackup/app.py:380
msgid ""
"Back up selected folders to removable drives with one click or automatically "
"when the drive is inserted."
msgstr ""
"Резервное копирование выбранных папок на сменные носители одной кнопкой или "
"автоматически при вставке носителя."

#: plugbackup/core/deps.py:81
msgid "Interface"
msgstr "Интерфейс"

#: plugbackup/core/deps.py:84 plugbackup/core/deps.py:87
msgid "Drive detection"
msgstr "Обнаружение носителей"

#: plugbackup/core/deps.py:87
msgid "UDisks2 service (udisks2)"
msgstr "Служба UDisks2 (udisks2)"

#: plugbackup/core/deps.py:88
msgid "The org.freedesktop.UDisks2 service is not available on the system bus"
msgstr "Служба org.freedesktop.UDisks2 недоступна на системной шине"

#: plugbackup/core/deps.py:93
msgid "Copying"
msgstr "Копирование"

#: plugbackup/core/deps.py:96
msgid "Notifications"
msgstr "Уведомления"

#: plugbackup/core/deps.py:105
msgid "Neither XApp nor AyatanaAppIndicator3 is installed"
msgstr "Не установлен ни XApp, ни AyatanaAppIndicator3"

#: plugbackup/core/deps.py:107
msgid "Tray icon"
msgstr "Значок в трее"

#: plugbackup/core/deps.py:112 plugbackup/core/deps.py:115
msgid "Password storage"
msgstr "Хранение паролей"

#: plugbackup/core/deps.py:115
msgid "Keyring service (Secret Service)"
msgstr "Служба связки ключей (Secret Service)"

#: plugbackup/core/deps.py:116
msgid "No Secret Service on the session bus (for example, gnome-keyring)"
msgstr "Нет службы Secret Service на сеансовой шине (например, gnome-keyring)"

#: plugbackup/core/deps.py:121
msgid "Encrypted drives (LUKS)"
msgstr "Зашифрованные носители (LUKS)"

#: plugbackup/core/deps.py:125 plugbackup/core/deps.py:128
msgid "Encrypted folder (gocryptfs)"
msgstr "Зашифрованная папка (gocryptfs)"

#: plugbackup/core/fsinfo.py:39
msgid "Files of 4 GiB (4,294,967,296 bytes) and larger do not fit."
msgstr "Файлы размером 4 ГиБ (4 294 967 296 байт) и больше не поместятся."

#: plugbackup/core/fsinfo.py:40 plugbackup/core/fsinfo.py:43
msgid "Linux permissions and symbolic links are not preserved."
msgstr "Права доступа Linux и символьные ссылки не сохраняются."

#: plugbackup/core/fsinfo.py:45
msgid "Linux permissions are not preserved."
msgstr "Права доступа Linux не сохраняются."

#: plugbackup/core/fsinfo.py:49 plugbackup/ui/volumes_view.py:185
msgid "This file system has not been tested with Plug & Backup."
msgstr "Эта файловая система не проверялась с Plug & Backup."

#: plugbackup/core/profiles.py:326
msgid "The backup folder name on the drive is empty."
msgstr "Не указано имя папки копии на носителе."

#: plugbackup/core/profiles.py:328
msgid "The backup folder on the drive must be a single folder name."
msgstr "Папка копии на носителе должна быть одним именем папки."

#: plugbackup/core/profiles.py:330 plugbackup/core/profiles.py:345
#, python-format
msgid "“%s” is a reserved service name."
msgstr "«%s» — зарезервированное служебное имя."

#: plugbackup/core/profiles.py:337
msgid "The destination folder on the drive is empty."
msgstr "Не указана папка на носителе."

#: plugbackup/core/profiles.py:339
msgid ""
"The destination must be a folder inside the backup folder, not an absolute "
"path."
msgstr ""
"Папка на носителе должна быть внутри папки копии, а не абсолютным путём."

#: plugbackup/core/profiles.py:342
msgid "The destination must not contain “..”."
msgstr "Путь на носителе не должен содержать «..»."

#: plugbackup/core/profiles.py:354
msgid "Choose a folder on this computer to back up."
msgstr "Выберите папку на этом компьютере."

#: plugbackup/core/profiles.py:356
msgid "The source folder must be an absolute path."
msgstr "Папка-источник должна быть абсолютным путём."

#: plugbackup/core/profiles.py:360
msgid "A system folder cannot be backed up as a whole."
msgstr "Системную папку целиком резервировать нельзя."

#: plugbackup/core/profiles.py:362
msgid "The source folder does not exist."
msgstr "Папки-источника не существует."

#: plugbackup/core/profiles.py:364
msgid "The source is not a folder."
msgstr "Источник — не папка."

#: plugbackup/core/profiles.py:366
msgid "The source folder cannot be read."
msgstr "Папку-источник нельзя прочитать."

#: plugbackup/core/profiles.py:369
msgid "The source folder is on the backup drive itself."
msgstr "Папка-источник находится на самом носителе копии."

#: plugbackup/core/profiles.py:372
msgid ""
"The source folder contains the backup drive; the copy would include itself."
msgstr ""
"Внутри папки-источника находится носитель копии — копия включала бы саму "
"себя."

#: plugbackup/core/profiles.py:381
#, python-format
msgid "The destination overlaps with another job (“%s”)."
msgstr "Папка на носителе пересекается с другим заданием («%s»)."

#: plugbackup/core/profiles.py:385
msgid "The source overlaps with another job; some files will be copied twice."
msgstr ""
"Источник пересекается с другим заданием — часть файлов скопируется дважды."

#: plugbackup/core/profiles.py:389
msgid ""
"Mirror mode: files deleted on this computer are deleted from the copy too, "
"and changed files replace their previous versions — they cannot be got back."
msgstr ""
"Режим «Зеркало»: файлы, удалённые на этом компьютере, удаляются и из копии, "
"а изменённые заменяют прежние версии — вернуть их будет нельзя."

#: plugbackup/core/profiles.py:392
msgid "The file size limit must be a positive number."
msgstr "Предел размера файла должен быть положительным числом."

#: plugbackup/core/profiles.py:395
msgid "An exclusion pattern must be a single line."
msgstr "Шаблон исключения должен быть одной строкой."

#: plugbackup/core/profiles.py:403
msgid "Enter a profile name."
msgstr "Введите имя профиля."

#: plugbackup/core/profiles.py:406
msgid "The countdown must be between 0 and 600 seconds."
msgstr "Отсчёт — от 0 до 600 секунд."

#: plugbackup/core/profiles.py:408
msgid "Versions must be kept for at least one day."
msgstr "Версии нужно хранить хотя бы один день."

#. TRANSLATORS: folder name in the home folder for files restored into another place
#: plugbackup/core/restore.py:33
msgid "Restored"
msgstr "Восстановлено"

#: plugbackup/core/restore.py:95
msgid "Plug & Backup — files set aside during a restore"
msgstr "Plug & Backup — файлы, отложенные при восстановлении"

#: plugbackup/core/restore.py:98
#, python-format
msgid "Restored at: %s"
msgstr "Восстановление: %s"

#: plugbackup/core/restore.py:99
#, python-format
msgid "From the copy: %s"
msgstr "Из копии: %s"

#: plugbackup/core/restore.py:100
#, python-format
msgid "Into the folder: %s"
msgstr "В папку: %s"

#: plugbackup/core/restore.py:101
msgid ""
"These are the versions of files that were in the folder on this computer "
"BEFORE the restore and that the restore overwrote. Paths inside this folder "
"are the same as in the target folder. To get a file back, copy it from here "
"to the target folder."
msgstr ""
"Здесь лежат версии файлов, которые были в папке на компьютере ДО "
"восстановления и которые восстановление перезаписало. Пути внутри этой папки "
"— те же, что в папке назначения. Чтобы вернуть файл, скопируйте его отсюда "
"обратно в папку назначения."

#: plugbackup/ui/auto_controller.py:146
msgid "Drive conflict"
msgstr "Конфликт носителей"

#: plugbackup/ui/auto_controller.py:146
#, python-format
msgid ""
"Two connected drives have the same identifier; automatic backup of “%s” will "
"not start."
msgstr ""
"У двух подключённых носителей одинаковый идентификатор — автоматическое "
"резервирование «%s» не запустится."

#: plugbackup/ui/auto_controller.py:173 plugbackup/ui/auto_controller.py:194
#: plugbackup/ui/auto_controller.py:269 plugbackup/ui/auto_controller.py:333
#, python-format
msgid "Automatic backup: %s"
msgstr "Автоматическое резервирование: %s"

#: plugbackup/ui/auto_controller.py:176
#, python-format
msgid ""
"Automatic backup of profile “%s” will start after the encrypted folder is "
"opened."
msgstr ""
"Автоматическое резервирование профиля «%s» начнётся после открытия "
"зашифрованной папки."

#: plugbackup/ui/auto_controller.py:198
#, python-format
msgid ""
"Automatic backup of profile “%s” will start after the drive is unlocked."
msgstr ""
"Автоматическое резервирование профиля «%s» начнётся после разблокировки "
"носителя."

#: plugbackup/ui/auto_controller.py:247
#, python-format
msgid "New drive: %s"
msgstr "Новый носитель: %s"

#: plugbackup/ui/auto_controller.py:248
msgid "Create a backup profile for it?"
msgstr "Создать для него профиль резервного копирования?"

#: plugbackup/ui/auto_controller.py:249
msgid "Create profile"
msgstr "Создать профиль"

#: plugbackup/ui/auto_controller.py:250
msgid "Don’t ask for this drive"
msgstr "Не спрашивать для этого носителя"

#: plugbackup/ui/auto_controller.py:265
#, python-format
msgid "Starts in %d s."
msgstr "Начнётся через %d с."

#: plugbackup/ui/auto_controller.py:267
#, python-format
msgid "Files to change: %d (%s)."
msgstr "Файлов к изменению: %d (%s)."

#: plugbackup/ui/auto_controller.py:271 plugbackup/ui/common.py:58
#: plugbackup/ui/encryption.py:43 plugbackup/ui/encryption.py:145
#: plugbackup/ui/import_dialog.py:16 plugbackup/ui/job_dialog.py:23
#: plugbackup/ui/main_window.py:210 plugbackup/ui/profile_actions.py:586
#: plugbackup/ui/profile_actions.py:627 plugbackup/ui/profile_dialog.py:27
#: plugbackup/ui/profile_view.py:612 plugbackup/ui/restore_dialog.py:41
#: plugbackup/ui/restore_dialog.py:135 plugbackup/ui/unlock.py:57
msgid "Cancel"
msgstr "Отмена"

#: plugbackup/ui/auto_controller.py:272
msgid "Now"
msgstr "Сейчас"

#: plugbackup/ui/auto_controller.py:326
#, python-format
msgid "Result: %s"
msgstr "Итог: %s"

#: plugbackup/ui/auto_controller.py:328
#, python-format
msgid "Copied files: %d"
msgstr "Скопировано файлов: %d"

#: plugbackup/ui/auto_controller.py:334 plugbackup/ui/main_window.py:69
#: plugbackup/ui/run_dialogs.py:112
msgid "Details"
msgstr "Подробнее"

#: plugbackup/ui/auto_controller.py:355 plugbackup/ui/volumes_view.py:249
#, python-format
msgid "The encrypted folder on the drive is in use: %s"
msgstr "Зашифрованная папка на носителе занята: %s"

#: plugbackup/ui/auto_controller.py:361
msgid "Could not eject the drive"
msgstr "Не удалось извлечь носитель"

#: plugbackup/ui/auto_controller.py:363
msgid "The drive can be removed"
msgstr "Носитель можно вынимать"

#: plugbackup/ui/auto_controller.py:365
msgid "The drive is unmounted"
msgstr "Носитель отключён"

#: plugbackup/ui/auto_controller.py:365
msgid ""
"The device was not powered off: another partition on it is still in use."
msgstr ""
"Питание устройства не выключено: другой раздел на нём ещё используется."

#: plugbackup/ui/common.py:10
msgid "Mirror with version history"
msgstr "Зеркало с корзиной версий"

#: plugbackup/ui/common.py:11
msgid "Mirror"
msgstr "Зеркало"

#: plugbackup/ui/common.py:12
msgid "Accumulate"
msgstr "Накопление"

#: plugbackup/ui/common.py:15
msgid ""
"The copy matches the folder; deleted and replaced files are moved to the "
"version history on the drive and kept for the set number of days."
msgstr ""
"Копия совпадает с папкой; удалённые и заменённые файлы переносятся в корзину "
"версий на носителе и хранятся заданное число дней."

#: plugbackup/ui/common.py:17
msgid ""
"The copy matches the folder exactly: files deleted on this computer are "
"permanently deleted from the copy."
msgstr ""
"Копия в точности совпадает с папкой: удалённое на этом компьютере удаляется "
"и в копии — безвозвратно."

#: plugbackup/ui/common.py:19
msgid ""
"New and changed files are copied; nothing is ever deleted from the copy."
msgstr "Копируются новые и изменённые файлы; из копии ничего не удаляется."

#: plugbackup/ui/common.py:22
msgid "By size and modification time (fast)"
msgstr "По размеру и времени изменения (быстро)"

#: plugbackup/ui/common.py:23
msgid "By content (slow, reads every file)"
msgstr "По содержимому (медленно, читает каждый файл)"

#: plugbackup/ui/common.py:26
msgid "Automatic: keep as links on ext4, skip on other file systems"
msgstr "Автоматически: на ext4 — как ссылки, на других ФС — пропускать"

#: plugbackup/ui/common.py:27
msgid "Skip links"
msgstr "Пропускать ссылки"

#: plugbackup/ui/common.py:28
msgid "Copy what the link points to"
msgstr "Копировать то, на что указывает ссылка"

#: plugbackup/ui/common.py:34
msgid "This drive is not bound to the profile."
msgstr "Этот носитель не привязан к профилю."

#: plugbackup/ui/common.py:35 plugbackup/ui/profile_view.py:487
msgid "The drive is encrypted and locked."
msgstr "Носитель зашифрован и заблокирован."

#: plugbackup/ui/common.py:36
msgid "The drive is not mounted."
msgstr "Носитель не подключён."

#: plugbackup/ui/common.py:37 plugbackup/ui/common.py:38
msgid "The mounted file system does not match the profile’s drive."
msgstr "Подключённая файловая система не совпадает с носителем профиля."

#: plugbackup/ui/common.py:39
msgid "Only a subfolder of the drive is mounted."
msgstr "Подключена только папка носителя, а не весь носитель."

#: plugbackup/ui/common.py:40
msgid "The drive is mounted read-only."
msgstr "Носитель подключён только для чтения."

#: plugbackup/ui/common.py:41
msgid "You do not have permission to write to the drive."
msgstr "Нет прав на запись на носитель."

#: plugbackup/ui/common.py:42
msgid "The backup folder name is invalid."
msgstr "Недопустимое имя папки копии."

#: plugbackup/ui/common.py:43
msgid ""
"The backup folder on the drive is a link to somewhere else; it will not be "
"used."
msgstr ""
"Папка копии на носителе — ссылка в другое место; она использоваться не будет."

#: plugbackup/ui/common.py:44
msgid ""
"Something that is not a folder has the backup folder’s name on the drive."
msgstr "На носителе с именем папки копии лежит не папка."

#: plugbackup/ui/common.py:45 plugbackup/ui/run_texts.py:103
msgid "The profile’s encrypted folder has not been created on this drive yet."
msgstr "Зашифрованная папка профиля на этом носителе ещё не создана."

#: plugbackup/ui/common.py:46
msgid "The profile’s encrypted folder is closed."
msgstr "Зашифрованная папка профиля закрыта."

#: plugbackup/ui/common.py:47
msgid "The backup folder on the drive belongs to another profile."
msgstr "Папка копии на носителе принадлежит другому профилю."

#: plugbackup/ui/common.py:48
msgid "The profile marker on the drive is damaged."
msgstr "Метка профиля на носителе повреждена."

#: plugbackup/ui/common.py:49
msgid ""
"The backup folder on the drive already contains data without a profile "
"marker."
msgstr "В папке копии на носителе уже есть данные без метки профиля."

#: plugbackup/ui/common.py:51
#, python-format
msgid "The drive cannot be used right now (%s)."
msgstr "Носитель сейчас нельзя использовать (%s)."

#: plugbackup/ui/deps_dialog.py:11
msgid "Available"
msgstr "Доступно"

#: plugbackup/ui/deps_dialog.py:13
msgid "Required component is missing"
msgstr "Нет обязательного компонента"

#: plugbackup/ui/deps_dialog.py:15
msgid "Unavailable — the feature is turned off"
msgstr "Недоступно — функция отключена"

#: plugbackup/ui/deps_dialog.py:41 plugbackup/ui/main_window.py:43
msgid "System check"
msgstr "Проверка системы"

#: plugbackup/ui/deps_dialog.py:42 plugbackup/ui/main_window.py:253
#: plugbackup/ui/profile_view.py:557 plugbackup/ui/restore_dialog.py:135
#: plugbackup/ui/run_dialogs.py:96 plugbackup/ui/run_dialogs.py:222
#: plugbackup/ui/run_dialogs.py:235
msgid "Close"
msgstr "Закрыть"

#: plugbackup/ui/encryption.py:24
msgid ""
"File contents and names are encrypted, but the number of files, their "
"approximate sizes, the folder structure and modification times can be seen "
"without the password."
msgstr ""
"Содержимое и имена файлов зашифрованы, но количество файлов, их примерные "
"размеры, структура папок и время изменения видны и без пароля."

#: plugbackup/ui/encryption.py:30
msgid ""
"The gocryptfs package is not installed. Install it with: sudo apt install "
"gocryptfs"
msgstr ""
"Пакет gocryptfs не установлен. Установите его командой: sudo apt install "
"gocryptfs"

#: plugbackup/ui/encryption.py:31
#, python-format
msgid "The installed gocryptfs is too old; version %s or newer is needed."
msgstr "Установленный gocryptfs слишком старый; нужна версия %s или новее."

#: plugbackup/ui/encryption.py:33
msgid "FUSE is not installed. Install it with: sudo apt install fuse3"
msgstr "FUSE не установлен. Установите его командой: sudo apt install fuse3"

#: plugbackup/ui/encryption.py:41
msgid "Create encrypted folder"
msgstr "Создание зашифрованной папки"

#: plugbackup/ui/encryption.py:44 plugbackup/ui/profile_dialog.py:28
msgid "Create"
msgstr "Создать"

#: plugbackup/ui/encryption.py:50
#, python-format
msgid "Password for the encrypted folder of profile “%s”"
msgstr "Пароль зашифрованной папки профиля «%s»"

#: plugbackup/ui/encryption.py:52
msgid "Password"
msgstr "Пароль"

#: plugbackup/ui/encryption.py:54
msgid "Repeat the password"
msgstr "Повторите пароль"

#: plugbackup/ui/encryption.py:59 plugbackup/ui/unlock.py:77
msgid "Remember the password in the keyring"
msgstr "Запомнить пароль в связке ключей"

#: plugbackup/ui/encryption.py:71
msgid ""
"Without the password and the master key (shown on the next step) the copy "
"cannot be recovered by anyone."
msgstr ""
"Без пароля и мастер-ключа (он будет показан на следующем шаге) копию не "
"сможет восстановить никто."

#: plugbackup/ui/encryption.py:81
msgid "The passwords do not match."
msgstr "Пароли не совпадают."

#: plugbackup/ui/encryption.py:83
msgid "A password of at least 8 characters is recommended."
msgstr "Рекомендуется пароль не короче 8 символов."

#: plugbackup/ui/encryption.py:100
msgid "Master key"
msgstr "Мастер-ключ"

#: plugbackup/ui/encryption.py:102 plugbackup/ui/run_dialogs.py:67
msgid "Continue"
msgstr "Продолжить"

#: plugbackup/ui/encryption.py:108
msgid "Save the master key of the encrypted folder"
msgstr "Сохраните мастер-ключ зашифрованной папки"

#: plugbackup/ui/encryption.py:112
msgid ""
"If the password is forgotten, the copy can be opened only with this key. "
